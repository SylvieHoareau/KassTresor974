MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 392502716}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 1883204c6c20a9440ac466813201c05c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  sequence:
  - speaker: {fileID: 11400000, guid: 6813abf958bacff4e80f58984fee61e7, type: 2}
    text: "\xE9coutons les nouvelles du jours"
  - speaker: {fileID: 11400000, guid: 68ff7f8cf3b26ea409742d14db8b2a03, type: 2}
    text: Flash infos
  - speaker: {fileID: 11400000, guid: 68ff7f8cf3b26ea409742d14db8b2a03, type: 2}
    text: "Aujourd'hui, c'est l'anniversaire de la mort du c\xE9l\xE8bre pirate \"La
      Buse\", dont le tr\xE9sor n'a toujours pas \xE9t\xE9 retrouv\xE9 \xE0 ce jour"
  - speaker: {fileID: 11400000, guid: 6813abf958bacff4e80f58984fee61e7, type: 2}
    text: "Ha si seulement j'avais ce tr\xE9sor... Je n'aurais plus \xE0 m'occuper
      de toutes mes t\xE2ches m\xE9nag\xE8res... "
  - speaker: {fileID: 11400000, guid: 6813abf958bacff4e80f58984fee61e7, type: 2}
    text: 'Mais bon... quand fo y aller, fo y aller! '
  startDelay: 3
