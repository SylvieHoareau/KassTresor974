  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuizNPC
  speakerProfile: {fileID: 11400000, guid: 2219297f7fd04fb4382399920fd7df6d, type: 2}
  greeting: "Ot\xE9, mi t\xE9 calcul ou t\xE9 fini kass kol\xE9 dans la caz la !"
  question: "Ou l\xE9 pr\xEAt pou aller coupe canne la ?! endirait ou sava danser
    ek ton linge"
  answers:
  - "Pas zordi, mi sa rod le tr\xE9zor La Buse"
  - "Ben reskab mi sa voir un kafrine, ou konn\xE9 pas ou"
  correctAnswerIndex: 1
  victoryText: "Mi konn\xE9 pas kossa la passe dans out t\xEAte mais mi pense pas
    un couyon comme ou va gaign trouv son tr\xE9zor hein !"
  defeatText: "Mi voit pas kel kafrine y veut woir un crout\xE9 comme ou lala, mais
    bon, si ou dit !"
  onWin:
    m_PersistentCalls:
      m_Calls: []
