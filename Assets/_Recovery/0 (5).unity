--- !u!114 &1314634239
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1314634237}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "La v\xE9ritable histoire d'une fausse tombe.\n\nCondamn\xE9 pour crime
    de piraterie, Olivier Le Vasseur, surnomm\xE9 La Buse, a \xE9t\xE9 ex\xE9cut\xE9
    \xE0 Saint-Paul le 7 juillet 1730 et son corps expos\xE9 au bord de la mer. Le
    lieu exact de son inhumation reste inconnu et le cimeti\xE8re actuel n'a \xE9t\xE9
    cr\xE9\xE9 qu'en 1788.\nLe 11 avril 1944, au lendemain d'un cyclone et d'un raz-de-mar\xE9e
    d\xE9vastateurs, le Saint-Paulois Ignace de Vill\xE8le retrouve une croix de
    pierre parmi les d\xE9bris des murs d\xE9vast\xE9s du cimeti\xE8re. Comme elle
    ne porte aucune autre indication que des symboles de pirate, il la d\xE9place
    jusqu'ici et la d\xE9pose contre l'enclos des s\xE9pultures de sa famille.\nC'est
    \xE0 cet emplacement, dans les ann\xE9es 1970, que l'actuel monument fun\xE9raire
    est \xE9rig\xE9 \xE0 la m\xE9moire de La Buse. Il attire tellement de visiteurs
    qu'on finit par le consid\xE9rer comme la vraie tombe du personnage, contribuant
    ainsi \xE0 sa c\xE9l\xE9brit\xE9.\nDepuis 2010 on sait que la pierre tombale
    utilis\xE9e provenait d'une s\xE9pulture abandonn\xE9e, celle de l'ancienne esclave
    Delphine H\xE9lod. Ayant \xE9t\xE9 affranchie en 1835 par ses ma\xEEtres, la
    famille Mallac, elle avait pu \xEAtre inhum\xE9e dans le cimeti\xE8re des Blancs
    et des libres, contrairement au pirate en 1730.\nLa pierre avait \xE9t\xE9 retourn\xE9e.
    Sa face grav\xE9e porte toujours cette inscription :\n\n\" A LA MEMOIRE DE DELPHINE
    HELOD N\xC9E A SAINTE-MARIE LE 7 AOUT 1809, DECEDEE LE 13 MAI 1836. SA BONNE
    CONDUITE, SES BONS SENTIMENTS, SON AFFECTION POUR SES MA\xCETRES LUI VALURENT
    LA LIBERT\xC9 ET CE FAIBLE T\xC9MOIGNAGE DE LEURS REGRETS. \""
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
